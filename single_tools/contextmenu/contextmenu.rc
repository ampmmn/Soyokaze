#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
/////////////////////////////////////////////////////////////////////////////
//
// アイコン
//

IDI_CONTEXTMENU       ICON         "contextmenu.ico"
IDI_SMALL              ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// バージョン情報
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "contextmenu"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "contextmenu"
            VALUE "OriginalFilename", "contextmenu.exe"
            VALUE "ProductName", "contextmenu"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
